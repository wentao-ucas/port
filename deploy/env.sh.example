# 生产环境变量模板（DB 连接 / 端口 / 门禁密码 / 时区）
# 用法：拷成同目录 env.sh 并填真实值。control.sh 和 systemd 都会自动加载它。
#   cp env.sh.example env.sh && vi env.sh
# 注意：env.sh 含明文密码，不要提交到代码库（加进 .gitignore）。
# 格式为 KEY=value（不要写 export、值里别带空格），control.sh 与 systemd EnvironmentFile 通用。
# 不设这些环境变量时，config.py 默认连 localhost（仅本地开发用）。

DB_HOST=<your-db-host>
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<your-db-password>
DB_NAME=chronos
APP_PORT=18760
ACCESS_PASSWORD=<your-access-password>
TZ=Asia/Shanghai

# 可选：指定 python 解释器（没建 venv、且 python3.9 不在 PATH 时填具体路径）
# PYTHON_BIN=/usr/local/bin/python3.9
