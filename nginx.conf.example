# Nginx 配置示例 - 工时报工系统
# 用于通过 nginx 反向代理访问工时系统

# 配置示例1: 作为独立服务 (推荐)
# 访问地址: http://yourdomain.com/worktime/
location /worktime/ {
    # 代理到后端服务
    proxy_pass http://localhost:8000/;
    
    # 代理头设置
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    
    # 超时设置
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    
    # 文件上传大小限制
    client_max_body_size 10M;
}

# 配置示例2: 使用子域名
# 访问地址: http://worktime.yourdomain.com/
server {
    listen 80;
    server_name worktime.yourdomain.com;
    
    location / {
        proxy_pass http://localhost:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        client_max_body_size 10M;
    }
}

# 配置示例3: 与其他系统共存 (指定路径)
# 访问地址: http://yourdomain.com/worktime-system/
# 注意: 如果使用路径部署，需要修改前端的 base URL
location /worktime-system/ {
    # 去除前缀再转发
    rewrite ^/worktime-system/(.*)$ /$1 break;
    
    proxy_pass http://localhost:8000/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    
    client_max_body_size 10M;
}

# ============================================
# 部署说明
# ============================================

# 1. 复制配置到 nginx
#    sudo cp nginx.conf.example /etc/nginx/conf.d/worktime.conf

# 2. 修改配置
#    - 替换 yourdomain.com 为实际域名
#    - 替换 localhost:8000 为实际后端地址
#    - 选择合适的配置示例（示例1/2/3）

# 3. 测试配置
#    sudo nginx -t

# 4. 重启 nginx
#    sudo systemctl reload nginx

# ============================================
# API 路由说明
# ============================================
# 
# 所有 API 使用 /worktime-api/ 前缀，避免与其他系统冲突：
# 
# - /worktime-api/config          - 配置管理
# - /worktime-api/generate        - 生成工时记录
# - /worktime-api/records         - 记录管理
# - /worktime-api/excel/export    - 导出Excel
# - /worktime-api/excel/import    - 导入Excel
# - /worktime-api/submit          - 提交记录
# 
# 这个路由前缀设计避免了常见的 /api/* 冲突问题
